{
  "_comment": "Maps Max Payne 3 textures (from pc.rpf) onto cs16-client gamedir paths. The decoded images are Rockstar assets and are NOT committed to this repo -- run scripts/import_mp3_assets.py against your own Max Payne 3 install to generate them locally. Only this manifest and the script are tracked.",

  "sources": [
    "textures/hud.wtd",
    "textures/crosshairs.wtd",
    "textures/blips.wtd",
    "textures/payne_hud_mp.wtd",
    "textures/payne_hud_common.wtd",
    "textures/allfontsintwo.wtd"
  ],

  "assets": [
    { "src": "radarringfront",   "dest": "gfx/mp3/radar_ring.png" },
    { "src": "radarringback",    "dest": "gfx/mp3/radar_ring_back.png" },
    { "src": "radar_centre",     "dest": "gfx/mp3/radar_player.png" },
    { "src": "radar_players_dir","dest": "gfx/mp3/radar_blip.png" },
    { "src": "radar_north",      "dest": "gfx/mp3/radar_north.png" },
    { "src": "crosshairring",    "dest": "gfx/mp3/crosshair_ring.png" },
    { "src": "crosshairdot",     "dest": "gfx/mp3/crosshair_dot.png" },
    { "src": "crosshairdmg",     "dest": "gfx/mp3/crosshair_kill.png" },
    { "src": "death_numbers",    "dest": "gfx/mp3/death_numbers.png" },
    { "src": "health_def",       "dest": "gfx/mp3/health_silhouette.png" },
    { "src": "ammo_pistol",      "dest": "gfx/mp3/ammo_pistol.png" },
    { "src": "ammo_rifle",       "dest": "gfx/mp3/ammo_rifle.png" },
    { "src": "ammo_smg",         "dest": "gfx/mp3/ammo_smg.png" },
    { "src": "ammo_shotgun",     "dest": "gfx/mp3/ammo_shotgun.png" },
    { "src": "ammo_sniper",      "dest": "gfx/mp3/ammo_sniper.png" },
    { "src": "sb_kills",         "dest": "gfx/mp3/sb_kills.png" },
    { "src": "sb_deaths",        "dest": "gfx/mp3/sb_deaths.png" },
    { "src": "sb_assists",       "dest": "gfx/mp3/sb_assists.png" },
    { "src": "mp_level_mic",     "dest": "gfx/mp3/sb_mic.png" },
    { "src": "allfontsintwo",    "dest": "gfx/mp3/font.png" },
    { "src": "allfontsinone",    "dest": "gfx/mp3/font_big.png",
      "_why": "same font family at ~46px cap height (1024 atlas, caps+digits+symbols) for big HUD text -- the 512 atlas only has ~21px glyphs, which pixelate when upscaled" },
    { "src": "damage_ind",      "dest": "gfx/mp3/damage_indicator.png" }
  ]
}
